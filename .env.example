# Configuration Supabase
# Copiez ce fichier en .env et remplissez avec vos vraies clés

# URL de votre projet Supabase
# Trouvez-la dans : Supabase Dashboard > Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clé anonyme (anon/public key)
# Trouvez-la dans : Supabase Dashboard > Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Ne commitez JAMAIS le fichier .env avec vos vraies clés !
# Ajoutez .env dans votre .gitignore
